# Environment Configuration
# Copy this file to .env and update with your actual credentials
# .env file is gitignored and will not be committed to version control

# ========================================
# IMPORTANT: URLs Auto-Select Based on TEST_ENV
# ========================================
# Just set TEST_ENV and URLs will be automatically chosen:
#   TEST_ENV=local      → http://localhost:3000
#   TEST_ENV=staging    → https://staging.eventhub.rahulshettyacademy.com
#   TEST_ENV=production → https://eventhub.rahulshettyacademy.com

# Environment Type: local, staging, production
TEST_ENV=production

# Base URLs (OPTIONAL - Only set if you want to override auto-selection)
# Leave empty to use auto-selected URLs based on TEST_ENV
BASE_URL=
API_BASE_URL=

# Test User Credentials
TEST_USER_EMAIL=your.email@example.com
TEST_USER_PASSWORD=YourPassword123

# Test Execution Settings
RUN_PARALLEL=true

# Browser Configuration (comma-separated)
# Available browsers: chromium, firefox, webkit
# Default: chromium,firefox,webkit (all browsers)
# Examples:
#   BROWSERS=chromium           (Chromium only)
#   BROWSERS=chromium,firefox   (Chromium and Firefox)
#   BROWSERS=chromium,firefox,webkit (All browsers - default)
BROWSERS=chromium,firefox,webkit
